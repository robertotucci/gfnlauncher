{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@main/*": ["src/main/*"],
      "@shared/*": ["src/shared/*"]
    }
  },
  // The preloads moved to tsconfig.preload.json when one of them grew a DOM.
  // Keeping them here would have meant adding "DOM" to the `lib` above, and
  // that lets a `document` reference into main, where it compiles clean and
  // throws at runtime.
  "include": ["src/main/**/*", "src/shared/**/*", "electron.vite.config.ts"]
}
