{
  "name": "gfn-launcher",
  "version": "0.1.0",
  "description": "Console-like, gamepad-driven launcher for NVIDIA GeForce NOW",
  "license": "AGPL-3.0-only",
  "author": "Roberto Tucci",
  "homepage": "https://github.com/robertotucci/gfn-launcher",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertotucci/gfn-launcher.git"
  },
  "bugs": {
    "url": "https://github.com/robertotucci/gfn-launcher/issues"
  },
  "keywords": [
    "geforce-now",
    "gfn",
    "launcher",
    "gamepad",
    "couch",
    "electron",
    "linux"
  ],
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "desktopName": "io.github.robertotucci.GfnLauncher.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:linux": "npm run build && electron-builder --linux",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "flatpak:sources": "node scripts/sync-electron-source.mjs",
    "flatpak:build": "flatpak run org.flatpak.Builder --force-clean --user --install --install-deps-from=flathub build-dir flatpak/io.github.robertotucci.GfnLauncher.yml"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "radix-ui": "^1.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.34.0",
    "globals": "^17.11.0",
    "lucide-react": "^0.542.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron@43.4.0": true
  }
}
